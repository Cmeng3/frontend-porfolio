{
  "projects": {
    "model": "Project",
    "table": "projects",
    "fields": {
      "project_category_id": {
        "type": "reference",
        "required": false,
        "rules": ["nullable", "integer", "exists:project_categorys,id"],
        "unique": false,
        "reference": "project_categorys"
      },
      "cover_media_id": {
        "type": "reference",
        "required": false,
        "rules": ["nullable", "integer", "exists:media,id"],
        "unique": false,
        "reference": "media"
      },
      "title": {
        "type": "text",
        "required": true,
        "rules": ["required", "string", "max:255"],
        "unique": false
      },
      "slug": {
        "type": "text",
        "required": true,
        "rules": [
          "required",
          "string",
          "max:255",
          "regex:/^[a-z0-9]+(?:-[a-z0-9]+)*$/"
        ],
        "unique": true
      },
      "summary": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:10000"],
        "unique": false
      },
      "description": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "problem": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "solution": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "architecture": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "challenges": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "outcomes": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "role": {
        "type": "text",
        "required": false,
        "rules": ["nullable", "string", "max:255"],
        "unique": false
      },
      "status": {
        "type": "select",
        "required": false,
        "rules": [
          "nullable",
          "string",
          "in:planned,in_progress,completed,maintained,archived,prototype,research"
        ],
        "unique": false,
        "options": [
          "planned",
          "in_progress",
          "completed",
          "maintained",
          "archived",
          "prototype",
          "research"
        ]
      },
      "repository_url": {
        "type": "url",
        "required": false,
        "rules": ["nullable", "string", "max:10000", "url:http,https"],
        "unique": false
      },
      "demo_url": {
        "type": "url",
        "required": false,
        "rules": ["nullable", "string", "max:10000", "url:http,https"],
        "unique": false
      },
      "started_on": {
        "type": "date",
        "required": false,
        "rules": ["nullable", "date"],
        "unique": false
      },
      "ended_on": {
        "type": "date",
        "required": false,
        "rules": ["nullable", "date"],
        "unique": false
      },
      "is_featured": {
        "type": "checkbox",
        "required": false,
        "rules": ["sometimes", "boolean"],
        "unique": false,
        "default": false
      },
      "sort_order": {
        "type": "number",
        "required": false,
        "rules": ["sometimes", "integer", "min:0", "max:2147483647"],
        "unique": false,
        "default": 0
      },
      "published_at": {
        "type": "datetime-local",
        "required": false,
        "rules": ["nullable", "date"],
        "unique": false
      },
      "target_users": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "key_features": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "database_design": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "api_architecture": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "lessons_learned": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "future_improvements": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:100000"],
        "unique": false
      },
      "architecture_media_id": {
        "type": "reference",
        "required": false,
        "rules": ["nullable", "integer", "exists:media,id"],
        "unique": false,
        "reference": "media"
      },
      "database_media_id": {
        "type": "reference",
        "required": false,
        "rules": ["nullable", "integer", "exists:media,id"],
        "unique": false,
        "reference": "media"
      },
      "technology_ids": {
        "type": "multi-reference",
        "required": false,
        "rules": ["sometimes", "array", "max:100"],
        "reference": "technologies",
        "relation": "technologies"
      },
      "media_ids": {
        "type": "multi-reference",
        "required": false,
        "rules": ["sometimes", "array", "max:100"],
        "reference": "media",
        "relation": "gallery"
      }
    },
    "relations": [
      "category",
      "cover",
      "architectureImage",
      "databaseImage",
      "technologies",
      "gallery"
    ]
  },
  "technologies": {
    "model": "Technology",
    "table": "technologies",
    "fields": {
      "name": {
        "type": "text",
        "required": true,
        "rules": ["required", "string", "max:255"],
        "unique": false
      },
      "slug": {
        "type": "text",
        "required": true,
        "rules": [
          "required",
          "string",
          "max:255",
          "regex:/^[a-z0-9]+(?:-[a-z0-9]+)*$/"
        ],
        "unique": true
      },
      "website_url": {
        "type": "url",
        "required": false,
        "rules": ["nullable", "string", "max:10000", "url:http,https"],
        "unique": false
      }
    },
    "relations": []
  },
  "project-categories": {
    "model": "ProjectCategory",
    "table": "project_categories",
    "fields": {
      "name": {
        "type": "text",
        "required": true,
        "rules": ["required", "string", "max:255"],
        "unique": false
      },
      "slug": {
        "type": "text",
        "required": true,
        "rules": [
          "required",
          "string",
          "max:255",
          "regex:/^[a-z0-9]+(?:-[a-z0-9]+)*$/"
        ],
        "unique": true
      },
      "description": {
        "type": "textarea",
        "required": false,
        "rules": ["nullable", "string", "max:10000"],
        "unique": false
      },
      "sort_order": {
        "type": "number",
        "required": false,
        "rules": ["sometimes", "integer", "min:0", "max:2147483647"],
        "unique": false,
        "default": 0
      }
    },
    "relations": []
  }
}
