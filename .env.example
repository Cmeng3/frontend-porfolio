# Frontend website origin, including https:// in production (not the API URL).
# On Vercel this may be omitted to use the generated deployment hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_URL=http://localhost:8000/api/v1
# Maximum public API wait in milliseconds (1000–60000); allows Render Free startup.
API_REQUEST_TIMEOUT_MS=60000
# Optional public HTTPS media base URL for Next.js image optimization, without a trailing slash.
# Example: https://cdn.example.com/portfolio
NEXT_PUBLIC_MEDIA_URL=
# Optional HTTPS profile URLs. Empty values show inactive social icons.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
